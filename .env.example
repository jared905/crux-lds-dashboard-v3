# Supabase Configuration
# Get these from: https://supabase.com/dashboard/project/_/settings/api
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# For Vercel cron jobs (server-side)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# YouTube Data API (for competitor syncing)
YOUTUBE_API_KEY=your-youtube-api-key

# YouTube OAuth Configuration (for client OAuth connections)
# Get these from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# Token Encryption Key (32 bytes, base64 encoded)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=your-32-byte-base64-key

# Frontend URL for OAuth redirects
FRONTEND_URL=https://your-app.vercel.app

# Optional: Cron secret for security
CRON_SECRET=your-random-secret-here

# Anthropic API (server-side, required)
# One key serves the whole team — nobody pastes a key into their browser.
# Powers the Claude proxy, channel classification, and brief narratives.
# Without it those endpoints return a clear "no API key" error.
ANTHROPIC_API_KEY=your-anthropic-api-key

# OpenAI API (server-side, optional)
# Only used by /api/openai-embeddings for Pre-flight topic-authority
# scoring. Without it that one panel omits its score; nothing else is
# affected.
OPENAI_API_KEY=your-openai-api-key
